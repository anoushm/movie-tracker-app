{
  "version": "1.0",
  "constitution": ".speckit.constitution.md",
  "testFramework": "playwright",
  "projectType": "angular",
  "sourceRoot": "src",
  "testRoot": "e2e",
  "testFilePattern": "e2e/**/*.spec.ts",
  "excludePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/assets/**"
  ],
  "testFileNaming": {
    "pattern": "{name}.spec.ts",
    "location": "e2e"
  },
  "playwright": {
    "baseURL": "http://localhost:4200",
    "testMatch": "**/*.spec.ts"
  },
  "templates": {
    "e2e": {
      "describe": "E2E: {name}",
      "testCases": [
        "should navigate and render correctly",
        "should handle user interactions",
        "should validate functionality end-to-end"
      ]
    },
    "feature": {
      "describe": "Feature: {name}",
      "testCases": [
        "should complete the user flow successfully"
      ]
    }
  }
}
