# Required because @ngrx/signals@22 is not yet published on npm, so v21.1.1
# (peer @angular/core@^21) conflicts with @angular/core@22 in this project.
# Applies to both local installs and Azure SWA's internal build, which we
# otherwise cannot pass flags to. Revisit and remove once @ngrx/signals@22
# ships.
legacy-peer-deps=true
