{
  "name": "movie-tracker-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "e2e": "playwright test",
    "e2e:local": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:4200 playwright test",
    "e2e:headed": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:4200 playwright test --headed",
    "e2e:my-favorite": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:4200 playwright test e2e/my-favorite/my-favorite.spec.ts --headed",
    "e2e:integration": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:4200 playwright test e2e/integration/full-app.spec.ts --headed",
    "e2e:local:win": "set PLAYWRIGHT_BASE_URL=http://localhost:4200&& playwright test",
    "e2e:headed:win": "set PLAYWRIGHT_BASE_URL=http://localhost:4200&& playwright test --headed",
    "e2e:no-server": "playwright test --config=playwright.config.ci.ts",
    "e2e:ci": "playwright test --config=playwright.config.ci.ts",
    "e2e:chrome": "playwright test --config=playwright.config.ci.ts --project=chromium",
    "e2e:firefox": "playwright test --config=playwright.config.ci.ts --project=firefox",
    "e2e:safari": "playwright test --config=playwright.config.ci.ts --project=webkit",
    "e2e:install": "playwright install",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.26",
    "@angular/common": "^20.3.26",
    "@angular/compiler": "^20.3.26",
    "@angular/core": "^20.3.26",
    "@angular/forms": "^20.3.26",
    "@angular/platform-browser": "^20.3.26",
    "@angular/platform-browser-dynamic": "^20.3.26",
    "@angular/router": "^20.3.26",
    "@ngrx/signals": "^20.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.26",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3"
  }
}
